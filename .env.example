# Copy this file to .env and set your own values. .env is git-ignored.
POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend datasource (read by Spring Boot; password must match POSTGRES_PASSWORD)
DB_URL=jdbc:postgresql://localhost:5432/fintrack
DB_USERNAME=fintrack
DB_PASSWORD=change-me
